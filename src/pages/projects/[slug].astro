---
import ProjectPage from '../../components/ProjectPage.astro';
import { getProjects, isProjectReady } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter((p) => isProjectReady(p.entry)).map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---
<ProjectPage lang="ru" slug={slug!} />
