---
import type { Lang } from '../lib/content';
import { getSettings } from '../lib/content';
import { useUi, localePath } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useUi(lang);
const settings = await getSettings();
const year = new Date().getFullYear();
---
<footer class="section footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__signature">
        {
          settings.signature ? (
            <img src={settings.signature} alt="Kasta Design" loading="lazy" />
          ) : (
            <span class="footer__signature-text" aria-label="Kasta Design">kd</span>
          )
        }
      </div>
      <div class="footer__divider"></div>
      <div class="footer__bottom text-s">
        <span>{year} Kasta Design</span>
        <a class="footer__link" href={localePath(lang, '/privacy/')}>{t.privacy}</a>
      </div>
    </div>
  </div>
</footer>
