---
import { tr, type Lang } from '../../lib/content';
import { sectionIds } from '../../i18n/ui';

interface Props {
  lang: Lang;
  content: any;
  reviews: { slug: string; entry: any }[];
}

const { lang, content, reviews } = Astro.props;
const columns = ['1', '2', '3'].map((c) => reviews.filter((r) => (r.entry.column || '1') === c)).filter((c) => c.length);
---
<section class="section reviews" id={sectionIds.reviews}>
  <div class="container">
    <div class="reviews__inner">
      <h2 class="h2 reviews__title">{tr(content.title, lang)}</h2>
      <div class="reviews__list">
        {
          columns.map((col, i) => (
            <div class="reviews__column" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              {col.map(({ entry }) => (
                <figure class="review">
                  <blockquote class="text review__text">{tr(entry.text, lang)}</blockquote>
                  {entry.time && <figcaption class="text-s review__time">{entry.time}</figcaption>}
                </figure>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
